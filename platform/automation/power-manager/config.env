# ============ Nodes ============
NODE_ALWAYS_ON=hp260g4
NODE_BURST=nipogi
BURST_NODE_IP=192.168.178.102

# ============ Home Assistant ============
# Interner Service (HA laeuft mit hostNetwork auf dem HP). Entity = Steckdose von nipogi.
# Den Entity-Namen nach dem Einrichten in Home Assistant pruefen (Einstellungen -> Geraete & Dienste -> Entitaeten).
HA_URL=http://home-assistant.home-assistant.svc.cluster.local:8123
HA_SWITCH_ENTITY=switch.nipogi_power

# ============ Hochfahren (nur wenn Burst-Workloads auf dem HP laufen) ============
# HP-CPU/RAM im Durchschnitt ueber UP_SUSTAIN_SECONDS >= Schwelle  ODER  Burst-Pod nicht schedulbar
UP_CPU_PCT=75
UP_MEM_PCT=85
UP_SUSTAIN_SECONDS=180
PENDING_SUSTAIN_SECONDS=90
# Mindestzeit zwischen Ausschalten und erneutem Einschalten (schont Hardware, verhindert Flapping)
MIN_OFFTIME_SECONDS=300
# Bootet der Node nicht innerhalb dieser Zeit -> Steckdose aus (Strom-Zyklus), spaeter neuer Versuch
BOOT_TIMEOUT_SECONDS=600

# ============ Herunterfahren ============
# Node-CPU im Durchschnitt ueber DOWN_SUSTAIN_SECONDS < DOWN_CPU_PCT  (1200s = 20 Minuten)
DOWN_CPU_PCT=15
DOWN_SUSTAIN_SECONDS=1200
# Nach dem Hochfahren mindestens so lange laufen lassen
MIN_UPTIME_SECONDS=900
# Schutz: nur herunterfahren, wenn der HP die Last danach tragen kann (projizierte Auslastung)
ABSORB_CPU_PCT=60
ABSORB_MEM_PCT=75
# Nicht herunterfahren, solange Spieler online sind (Minecraft Server-List-Ping; leer = deaktiviert)
BUSY_PROBES=minecraft-headless.minecraft.svc.cluster.local:25565
DRAIN_TIMEOUT_SECONDS=600
POWEROFF_GRACE_SECONDS=60
DOWN_RETRY_SECONDS=1800

# ============ Sonstiges ============
POLL_SECONDS=30
# true = nur loggen, nichts schalten. Wird automatisch aktiv, solange kein HA-Token hinterlegt ist.
DRY_RUN=false
